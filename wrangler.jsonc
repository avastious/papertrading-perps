// aureous-api: the Aureous trading server (Cloudflare Workers, free plan).
// Cloudflare deploys it from this repo on every push to main (Workers & Pages > Import a repository).
{
  "name": "aureous-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{"name": "EXCHANGE", "class_name": "Exchange"}]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["Exchange"]}
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "aureous-14551",
    "ALLOWED_ORIGINS": "https://aureous.pages.dev,https://avastious.github.io"
  },
  "observability": {"enabled": true}
}
