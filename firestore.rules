rules_version = '2';

// Aureous: each signed-in person can read and write only their own paper account.
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'session', 'updated'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000;
    }
  }
}
