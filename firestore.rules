rules_version = '2';

// Aureous security rules. Paste into Firebase console > Firestore Database > Rules > Publish.
//
// - Each signed-in person can read, save and delete only their own account document.
// - Saves must have exactly the shape the site writes; anything else is rejected.
// - Every other path in the database is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    match /accounts/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isValidSave() {
        let d = request.resource.data;
        return d.keys().hasOnly(['state', 'session', 'updated'])
          && d.state is string && d.state.size() < 900000
          && d.session is string && d.session.size() < 64
          && d.updated == request.time;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && isValidSave();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
